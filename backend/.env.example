# ── ANARC Registration Backend — Environment Variables ──
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/anarc?retryWrites=true&w=majority

# Gmail credentials (use an App Password, not your regular password)
# Enable 2FA on your Google account, then generate an App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Frontend origin for CORS (your GitHub Pages URL)
FRONTEND_ORIGIN=https://anarc-nita.github.io

# Port (Railway will set this automatically)
PORT=3000
